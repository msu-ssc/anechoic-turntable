# CubeIDE's managed-build descriptions in Debug/ are version-controlled so a
# clean checkout can build with GNU Tools for STM32. Ignore only generated outputs.
Debug/**/*.cyclo
Debug/**/*.d
Debug/**/*.o
Debug/**/*.su
Debug/*.elf
Debug/*.list
!Debug/objects.list
Debug/*.map
Debug/*.stdout

# Object files
*.o
*.ko
*.obj
*.elf

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Misc
*.map
*.m
*.png

# Eclipse CDT project files
.cproject
.project
.settings/

# Vagrant directory
.vagrant/

# Include makefiles
!Makefile
*~

# Libraries
/lib